<style>
/* ==========================================================
   TOKENS — identidade "Broken Style": asfalto + fita de risco
   ========================================================== */
:root{
  --bg: #141414;
  --bg-alt: #1B1B1B;
  --bg-alt-2: #202020;
  --concrete: #333333;
  --bone: #F2EEE6;
  --bone-muted: #A79E92;
  --yellow: #F4C11F;
  --red: #E2402F;
  --whatsapp: #25D366;

  --font-display: "Archivo Black", "Arial Black", sans-serif;
  --font-body: "Space Grotesk", -apple-system, sans-serif;
  --font-mono: "IBM Plex Mono", monospace;
  --font-marker: "Permanent Marker", cursive;

  --container: 1140px;
}

*,*::before,*::after{ box-sizing:border-box; }
html{ scroll-behavior:smooth; }
@media (prefers-reduced-motion: reduce){
  html{ scroll-behavior:auto; }
  *,*::before,*::after{ animation-duration:.01ms !important; animation-iteration-count:1 !important; transition-duration:.01ms !important; }
}

body{
  margin:0; background:var(--bg); color:var(--bone);
  font-family:var(--font-body); font-size:16px; line-height:1.6;
  -webkit-font-smoothing:antialiased;
}
img,svg{ max-width:100%; display:block; }
a{ color:inherit; }

.container{ max-width:var(--container); margin:0 auto; padding:0 24px; }

h1,h2,h3{ font-family:var(--font-display); color:var(--bone); margin:0 0 .5em; line-height:1.05; text-transform:uppercase; letter-spacing:-.01em; }

.eyebrow{
  font-family:var(--font-mono); text-transform:uppercase; letter-spacing:.14em; font-size:.72rem;
  color:var(--yellow); display:inline-flex; align-items:center; gap:.6em; margin-bottom:1em;
}
.eyebrow::before{ content:""; width:22px; height:2px; background:var(--yellow); }

.section{ padding:96px 0; position:relative; }
.section-alt{ background:var(--bg-alt); }
.lead{ color:var(--bone-muted); font-size:1.08rem; max-width:56ch; }

.skip-link{
  position:absolute; left:-999px; top:0; background:var(--yellow); color:var(--bg);
  padding:12px 18px; z-index:999; font-family:var(--font-mono); font-size:.85rem; font-weight:600;
}
.skip-link:focus{ left:12px; top:12px; }
:focus-visible{ outline:2px solid var(--yellow); outline-offset:3px; }

/* ==========================================================
   FITA DE RISCO (elemento de assinatura) — usada como faixa fina
   ========================================================== */
.hazard-strip{
  height:8px; width:100%;
  background: repeating-linear-gradient(45deg, var(--yellow) 0 16px, var(--bg) 16px 32px);
}

/* Divisor "rachadura" entre seções */
.crack-divider{ display:block; width:100%; height:20px; }

/* ==========================================================
   HEADER
   ========================================================== */
header.site-header{
  position:sticky; top:0; z-index:100;
  background:rgba(20,20,20,.88); backdrop-filter:blur(8px);
  border-bottom:1px solid rgba(244,193,31,.2);
  transition: box-shadow .25s ease;
}
header.site-header.scrolled{ box-shadow:0 8px 24px rgba(0,0,0,.45); }

.nav-wrap{ display:flex; align-items:center; justify-content:space-between; padding:14px 24px; max-width:var(--container); margin:0 auto; gap:20px; }
.brand{ display:flex; align-items:center; gap:10px; font-family:var(--font-display); font-size:1.15rem; text-decoration:none; text-transform:uppercase; white-space:nowrap; letter-spacing:-.01em; }
.brand .brand-crack{ color:var(--yellow); }

nav.main-nav{ display:flex; align-items:center; gap:26px; }
nav.main-nav a{ text-decoration:none; color:var(--bone-muted); font-size:.9rem; font-weight:500; position:relative; padding:4px 0; }
nav.main-nav a:hover, nav.main-nav a.active{ color:var(--bone); }
nav.main-nav a.active::after{ content:""; position:absolute; left:0; right:0; bottom:-4px; height:2px; background:var(--yellow); }

.btn{
  display:inline-flex; align-items:center; justify-content:center; gap:.55em;
  font-family:var(--font-body); font-weight:700; font-size:.94rem;
  padding:13px 22px; border-radius:2px; text-decoration:none;
  border:2px solid transparent; cursor:pointer; line-height:1;
  transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
  text-transform:uppercase; letter-spacing:.02em;
}
.btn:active{ transform:translateY(1px); }

.btn-whatsapp{ background:var(--whatsapp); color:#08210F; border-color:var(--bg); }
.btn-whatsapp:hover{ background:#2fe377; box-shadow:0 6px 18px rgba(37,211,102,.3); }

.btn-outline{ background:transparent; color:var(--bone); border-color:rgba(242,238,230,.3); }
.btn-outline:hover{ border-color:var(--yellow); color:var(--yellow); }

.btn-block{ width:100%; }
.nav-cta{ display:flex; }

.menu-toggle{ display:none; background:none; border:none; color:var(--bone); cursor:pointer; padding:8px; }
.menu-toggle svg{ width:26px; height:26px; }

/* ==========================================================
   HERO
   ========================================================== */
.hero{ position:relative; padding:84px 0 76px; overflow:hidden; background:var(--bg); }
.hero::before{
  content:""; position:absolute; inset:0;
  background-image:
    linear-gradient(rgba(242,238,230,.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(242,238,230,.025) 1px, transparent 1px);
  background-size: 42px 42px;
  pointer-events:none;
}
.hero-grid{ display:grid; grid-template-columns:1.15fr .85fr; gap:56px; align-items:center; position:relative; }

.hero h1{ font-size:clamp(2.2rem,4.6vw,3.5rem); margin-bottom:.3em; }
.crack-word{ position:relative; display:inline-block; color:var(--yellow); }
.crack-word::after{
  content:"QUEBRA"; position:absolute; left:2px; top:2px; z-index:-1;
  color:var(--red); opacity:.65;
}

.hero-actions{ display:flex; gap:14px; margin-top:28px; flex-wrap:wrap; }

.trust-row{ display:flex; align-items:center; gap:16px; margin-top:32px; flex-wrap:wrap; font-family:var(--font-mono); font-size:.8rem; color:var(--bone-muted); }
.stars{ color:var(--yellow); letter-spacing:2px; font-size:1rem; }

/* Painel lateral do hero (substitui foto) */
.hero-poster{ background:var(--bg-alt); border:2px solid var(--concrete); position:relative; padding:28px; }
.hero-poster::before{
  content:""; position:absolute; top:-8px; left:24px; right:24px; height:8px;
  background: repeating-linear-gradient(45deg, var(--yellow) 0 12px, var(--bg) 12px 24px);
}
.poster-title{ font-family:var(--font-mono); text-transform:uppercase; font-size:.72rem; letter-spacing:.14em; color:var(--yellow); margin-bottom:18px; }
.poster-row{ display:flex; justify-content:space-between; align-items:baseline; padding:12px 0; border-bottom:1px dashed rgba(242,238,230,.15); }
.poster-row:last-child{ border-bottom:none; }
.poster-row span:first-child{ color:var(--bone); font-weight:500; }
.poster-row span:last-child{ font-family:var(--font-mono); color:var(--yellow); }

/* ==========================================================
   STATS BAR
   ========================================================== */
.stats-bar{ background:var(--bg-alt-2); border-top:1px solid rgba(244,193,31,.15); border-bottom:1px solid rgba(244,193,31,.15); padding:34px 0; }
.stats-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:24px; text-align:center; }
.stat-num{ font-family:var(--font-display); font-size:1.8rem; color:var(--yellow); }
.stat-label{ font-family:var(--font-mono); font-size:.72rem; color:var(--bone-muted); text-transform:uppercase; letter-spacing:.08em; margin-top:6px; }

/* ==========================================================
   SERVIÇOS — cartões estilo "etiqueta de spray"
   ========================================================== */
.services-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:22px; margin-top:48px; }
.ticket{
  background:var(--bg-alt); border:2px solid var(--concrete); padding:26px 24px 22px;
  position:relative; display:flex; flex-direction:column; gap:14px;
  transition: transform .2s ease, border-color .2s ease;
}
.ticket:hover{ transform:translateY(-4px); border-color:var(--yellow); }
.ticket-top{ display:flex; justify-content:space-between; align-items:flex-start; gap:12px; }
.ticket-name{ font-family:var(--font-display); font-size:1.02rem; text-transform:uppercase; }
.ticket-price{ font-family:var(--font-mono); color:var(--yellow); font-size:1.05rem; white-space:nowrap; }
.ticket-price .old{ color:var(--bone-muted); font-size:.82rem; text-decoration:line-through; margin-right:6px; }
.ticket-desc{ color:var(--bone-muted); font-size:.92rem; flex-grow:1; }
.ticket-badge{
  position:absolute; top:-12px; left:20px; background:var(--red); color:var(--bone);
  font-family:var(--font-marker); font-size:.85rem; padding:2px 12px; transform:rotate(-3deg);
}
.ticket .btn{ margin-top:4px; padding:10px 16px; font-size:.82rem; }

/* ==========================================================
   DIFERENCIAIS
   ========================================================== */
.diff-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:26px; margin-top:48px; }
.diff-item{ display:flex; flex-direction:column; gap:14px; }
.diff-icon{ width:46px; height:46px; border:2px solid var(--yellow); display:flex; align-items:center; justify-content:center; color:var(--yellow); }
.diff-icon svg{ width:22px; height:22px; }
.diff-item h3{ font-size:.95rem; margin-bottom:4px; }
.diff-item p{ color:var(--bone-muted); font-size:.92rem; margin:0; text-transform:none; }

/* ==========================================================
   AMBIENTE
   ========================================================== */
.ambiente-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:18px; margin-top:48px; }
.ambiente-card{
  aspect-ratio:4/5; border:2px solid var(--concrete); display:flex; flex-direction:column;
  align-items:center; justify-content:center; gap:14px; text-align:center; padding:20px;
  background:linear-gradient(160deg, var(--bg-alt), var(--bg-alt-2));
}
.ambiente-card svg{ width:36px; height:36px; color:var(--yellow); }
.ambiente-card span{ font-family:var(--font-mono); font-size:.76rem; color:var(--bone-muted); text-transform:uppercase; letter-spacing:.06em; }

/* ==========================================================
   DEPOIMENTOS
   ========================================================== */
.testi-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:22px; margin-top:48px; }
.testi-card{ background:var(--bg-alt); border:2px solid var(--concrete); padding:26px; display:flex; flex-direction:column; gap:14px; }
.testi-stars{ color:var(--yellow); letter-spacing:2px; }
.testi-quote{ color:var(--bone); font-size:.96rem; margin:0; }
.testi-name{ font-family:var(--font-mono); font-size:.76rem; color:var(--bone-muted); text-transform:uppercase; letter-spacing:.06em; }

/* ==========================================================
   FAQ
   ========================================================== */
.faq-list{ margin-top:44px; max-width:760px; }
.faq-item{ border-bottom:1px solid var(--concrete); }
.faq-q{
  width:100%; background:none; border:none; text-align:left; cursor:pointer;
  padding:20px 0; display:flex; justify-content:space-between; align-items:center; gap:16px;
  color:var(--bone); font-family:var(--font-body); font-size:1rem; font-weight:600;
}
.faq-q .plus{ font-family:var(--font-mono); color:var(--yellow); font-size:1.2rem; transition:transform .2s ease; flex-shrink:0; }
.faq-item.open .plus{ transform:rotate(45deg); }
.faq-a{ max-height:0; overflow:hidden; transition:max-height .25s ease; color:var(--bone-muted); font-size:.95rem; }
.faq-a p{ margin:0 0 18px; max-width:62ch; }

/* ==========================================================
   CTA FINAL
   ========================================================== */
.cta-final{ background:var(--bg-alt-2); border-top:1px solid rgba(244,193,31,.2); text-align:center; }
.cta-final h2{ font-size:clamp(1.6rem,3.4vw,2.3rem); }
.cta-final .lead{ margin:0 auto 30px; }
.cta-final .btn{ font-size:1rem; padding:16px 30px; }

/* ==========================================================
   LOCALIZAÇÃO
   ========================================================== */
.location-grid{ display:grid; grid-template-columns:1fr 1fr; gap:40px; margin-top:44px; align-items:start; }
.hours-table{ width:100%; border-collapse:collapse; margin-top:18px; font-size:.94rem; }
.hours-table td{ padding:9px 0; border-bottom:1px dashed rgba(242,238,230,.14); }
.hours-table td:last-child{ text-align:right; font-family:var(--font-mono); color:var(--yellow); }
.map-embed{ border:2px solid var(--concrete); overflow:hidden; filter:grayscale(.5) contrast(1.05); }
.map-embed iframe{ width:100%; height:320px; border:0; display:block; }
.addr-line{ display:flex; gap:12px; margin-top:18px; align-items:flex-start; color:var(--bone-muted); font-size:.94rem; }
.addr-line svg{ width:18px; height:18px; color:var(--yellow); flex-shrink:0; margin-top:2px; }

/* ==========================================================
   FOOTER
   ========================================================== */
footer.site-footer{ background:var(--bg-alt-2); border-top:1px solid rgba(244,193,31,.2); padding:56px 0 26px; }
.footer-grid{ display:grid; grid-template-columns:1.3fr 1fr 1fr; gap:40px; }
.footer-brand{ display:flex; align-items:center; gap:10px; font-family:var(--font-display); font-size:1.1rem; margin-bottom:12px; text-transform:uppercase; }
.footer-brand span{ color:var(--yellow); }
.footer-col h4{ font-family:var(--font-mono); text-transform:uppercase; font-size:.72rem; letter-spacing:.1em; color:var(--yellow); margin:0 0 16px; }
.footer-col ul{ list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:10px; }
.footer-col a{ text-decoration:none; color:var(--bone-muted); font-size:.92rem; }
.footer-col a:hover{ color:var(--bone); }
.footer-bottom{
  margin-top:48px; padding-top:22px; border-top:1px solid rgba(242,238,230,.08);
  display:flex; justify-content:space-between; flex-wrap:wrap; gap:12px;
  font-size:.78rem; color:var(--bone-muted); font-family:var(--font-mono);
}

/* ==========================================================
   WHATSAPP FLUTUANTE
   ========================================================== */
.wa-float{
  position:fixed; right:20px; bottom:20px; z-index:200; display:flex; align-items:center; gap:10px;
  background:var(--whatsapp); color:#08210F; padding:14px 18px; border-radius:50px; border:2px solid var(--yellow);
  text-decoration:none; font-weight:700; font-size:.88rem; text-transform:uppercase;
  box-shadow:0 10px 26px rgba(0,0,0,.4);
  opacity:0; transform:translateY(16px) scale(.9); pointer-events:none;
  transition: opacity .25s ease, transform .25s ease;
}
.wa-float.visible{ opacity:1; transform:translateY(0) scale(1); pointer-events:auto; }
.wa-float svg{ width:22px; height:22px; }
.wa-float .wa-text{ display:none; }
@media(min-width:640px){ .wa-float .wa-text{ display:inline; } }

/* reveal on scroll */
.reveal{ opacity:0; transform:translateY(18px); transition: opacity .5s ease, transform .5s ease; }
.reveal.in{ opacity:1; transform:translateY(0); }
@media (prefers-reduced-motion: reduce){ .reveal{ opacity:1; transform:none; } }

/* ==========================================================
   RESPONSIVO
   ========================================================== */
@media (max-width:980px){
  .hero-grid{ grid-template-columns:1fr; }
  .stats-grid{ grid-template-columns:repeat(2,1fr); gap:30px; }
  .services-grid{ grid-template-columns:repeat(2,1fr); }
  .diff-grid{ grid-template-columns:repeat(2,1fr); }
  .ambiente-grid{ grid-template-columns:repeat(2,1fr); }
  .testi-grid{ grid-template-columns:1fr; }
  .location-grid{ grid-template-columns:1fr; }
  .footer-grid{ grid-template-columns:1fr 1fr; }
}
@media (max-width:720px){
  nav.main-nav{
    position:fixed; inset:64px 0 0 0; background:var(--bg); flex-direction:column; align-items:flex-start;
    padding:30px 24px; gap:22px; transform:translateX(100%); transition:transform .25s ease;
    border-top:1px solid rgba(244,193,31,.2);
  }
  nav.main-nav.open{ transform:translateX(0); }
  nav.main-nav a{ font-size:1.05rem; }
  .nav-cta .btn-outline{ display:none; }
  .menu-toggle{ display:inline-flex; }
  .section{ padding:64px 0; }
  .services-grid, .diff-grid, .ambiente-grid{ grid-template-columns:1fr; }
  .footer-grid{ grid-template-columns:1fr; gap:30px; }
  .hero-actions .btn{ width:100%; }
  .stats-grid{ grid-template-columns:repeat(2,1fr); }
}
</style>
