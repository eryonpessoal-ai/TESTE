  const WHATSAPP_NUMBER = "5591985415854"; // formato: DDI + DDD + número, só dígitos
  const MESSAGE_TEMPLATE = (service) =>
    `E aí! Vim pelo site da Broken Style e quero agendar: ${service}. Tem horário disponível?`;

  function buildWaLink(service){
    const text = encodeURIComponent(MESSAGE_TEMPLATE(service || "um horário"));
